{% comment %}
  CUSTOM FILE [AJ-008] — Bandeau de réassurance du pied de page | See CUSTOM_CHANGES.md — AJ-008

  Section contract.
  Bandeau autonome de services pour le groupe Footer : ligne égale sur ordinateur et pile sur mobile.
  Chaque service est un lien sémantique uniquement lorsqu’une destination est renseignée.
  @example
  Ajouter « AKAN — Réassurance » au groupe Footer, puis le placer au-dessus du pied de page principal.
{% endcomment %}

{% liquid
  assign usable_block_count = 0

  for block in section.blocks
    assign service_title = block.settings.title | strip
    assign service_text = block.settings.text | strip
    assign service_has_icon = false
    if block.settings.image != blank
      assign service_has_icon = true
    elsif block.settings.icon != blank and block.settings.icon != 'none'
      assign service_has_icon = true
    endif
    if service_title != blank or service_text != blank or service_has_icon
      assign usable_block_count = usable_block_count | plus: 1
    endif
  endfor
%}

{% if usable_block_count > 0 %}
  {% liquid
    assign color_scope = 'akn-trust-' | append: section.id
    render 'contrast-override', background_color: section.settings.background_color, text_color: section.settings.title_color, border_color: section.settings.separator_color, section_id: color_scope, preset: 'ui'
  %}

  <div
    class="akn-trust color-custom-{{ color_scope }}{% if section.settings.show_mobile_chevrons %} akn-trust--mobile-chevrons{% endif %}"
    style="
      --akn-trust-columns: {{ usable_block_count }};
      --akn-trust-icon-color: {{ section.settings.icon_color }};
      --akn-trust-title-color: {{ section.settings.title_color }};
      --akn-trust-text-color: {{ section.settings.text_color }};
      --akn-trust-separator-color: {{ section.settings.separator_color }};
      --akn-trust-icon-size-desktop: {{ section.settings.icon_size_desktop }}px;
      --akn-trust-icon-size-mobile: {{ section.settings.icon_size_mobile }}px;
      --akn-trust-padding-desktop: {{ section.settings.padding_desktop }}px;
      --akn-trust-padding-mobile: {{ section.settings.padding_mobile }}px;
    "
  >
    <div class="section section--page-width akn-trust__inner">
      <div class="akn-trust__grid">
        {% for block in section.blocks %}
          {% liquid
            assign service_title = block.settings.title | strip
            assign service_text = block.settings.text | strip
            assign has_icon = false
            if block.settings.image != blank
              assign has_icon = true
            elsif block.settings.icon != blank and block.settings.icon != 'none'
              assign has_icon = true
            endif

            assign is_usable = false
            if service_title != blank or service_text != blank or has_icon
              assign is_usable = true
            endif

            unless is_usable
              continue
            endunless

            assign has_accessible_text = false
            if service_title != blank or service_text != blank
              assign has_accessible_text = true
            endif

            assign has_link = false
            if block.settings.link != blank and has_accessible_text
              assign has_link = true
            endif

            assign surface_tag = 'div'
            if has_link
              assign surface_tag = 'a'
            endif
          %}

          <{{ surface_tag }}
            class="akn-trust__service{% if has_link %} akn-trust__service--link{% endif %}"
            {% if has_link %}href="{{ block.settings.link | escape }}"{% endif %}
            {{ block.shopify_attributes }}
          >
            {% if has_icon %}
              <span class="akn-trust__icon" aria-hidden="true">
                {% if block.settings.image != blank %}
                  {{
                    block.settings.image
                    | image_url: width: 192
                    | image_tag:
                      widths: '48, 64, 96, 128, 192',
                      sizes: '96px',
                      loading: 'lazy',
                      decoding: 'async',
                      alt: '',
                      class: 'akn-trust__image'
                  }}
                {% else %}
                  {% case block.settings.icon %}
                    {% when 'security' %}
                      <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
                        <path d="M16 2.75 27 7v7.5c0 7.18-4.58 12.15-11 14.75C9.58 26.65 5 21.68 5 14.5V7l11-4.25Z" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
                        <path d="m10.75 15.75 3.45 3.45 7.05-7.05" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {% when 'delivery' %}
                      <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
                        <path d="M3.5 8.5h15v15h-15zM18.5 13h5l5 5v5.5h-10z" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
                        <path d="M23.5 13v5h5M8.5 27.25a2.75 2.75 0 1 0 0-5.5 2.75 2.75 0 0 0 0 5.5ZM23.5 27.25a2.75 2.75 0 1 0 0-5.5 2.75 2.75 0 0 0 0 5.5Z" fill="var(--color-background)" stroke="currentColor" stroke-width="1.75"/>
                      </svg>
                    {% when 'contact' %}
                      <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
                        <path d="M5 5.5h22v16H13l-6.75 5v-5H5z" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
                        <path d="M10 13.5h12M10 17.5h7" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                      </svg>
                  {% endcase %}
                {% endif %}
              </span>
            {% endif %}

            {% if service_title != blank or service_text != blank %}
              <span class="akn-trust__content">
                {% if service_title != blank %}
                  <span class="akn-trust__title">{{ service_title | escape }}</span>
                {% endif %}
                {% if service_text != blank %}
                  <span class="akn-trust__text">{{ service_text | escape }}</span>
                {% endif %}
              </span>
            {% endif %}

            {% if has_link %}
              <svg class="akn-trust__chevron" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path d="m6 3 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            {% endif %}
          </{{ surface_tag }}>
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}

{% stylesheet %}
  /* CUSTOM [AJ-008] — Présentation isolée du bandeau de réassurance. | See CUSTOM_CHANGES.md — AJ-008 */
  .akn-trust {
    min-inline-size: 0;
    border-block: 1px solid var(--akn-trust-separator-color);
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .akn-trust__inner {
    padding-block: 0;
  }

  .akn-trust__grid {
    display: grid;
    grid-template-columns: 1fr;
    min-inline-size: 0;
  }

  .akn-trust__service {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--gap-lg);
    min-inline-size: 0;
    min-block-size: 72px;
    padding-block: var(--akn-trust-padding-mobile);
    color: inherit;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .akn-trust__service:not(:first-child) {
    border-block-start: 1px solid var(--akn-trust-separator-color);
  }

  .akn-trust__icon {
    display: grid;
    place-items: center;
    inline-size: var(--akn-trust-icon-size-mobile);
    block-size: var(--akn-trust-icon-size-mobile);
    min-inline-size: 0;
    color: var(--akn-trust-icon-color);
  }

  .akn-trust__icon svg,
  .akn-trust__image {
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }

  .akn-trust__image {
    object-fit: contain;
  }

  .akn-trust__content {
    display: grid;
    gap: var(--gap-2xs);
    min-inline-size: 0;
  }

  .akn-trust__title,
  .akn-trust__text {
    min-inline-size: 0;
    overflow-wrap: anywhere;
  }

  .akn-trust__title {
    color: var(--akn-trust-title-color);
    font-family: var(--font-subheading--family);
    font-size: var(--font-size--sm);
    font-weight: var(--font-subheading--weight);
    letter-spacing: 0.12em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .akn-trust__text {
    color: var(--akn-trust-text-color);
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm);
    line-height: 1.45;
  }

  .akn-trust__chevron {
    display: none;
    inline-size: 18px;
    block-size: 18px;
    color: var(--akn-trust-icon-color);
  }

  .akn-trust--mobile-chevrons .akn-trust__service--link .akn-trust__chevron {
    display: block;
  }

  .akn-trust__service--link {
    transition: background-color var(--animation-speed) var(--animation-easing);
  }

  .akn-trust__service--link:focus-visible {
    outline: 2px solid var(--akn-trust-icon-color);
    outline-offset: -3px;
  }

  @media (hover: hover) and (pointer: fine) {
    .akn-trust__service--link:hover {
      background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5));
    }
  }

  @media screen and (min-width: 750px) {
    .akn-trust__grid {
      grid-template-columns: repeat(var(--akn-trust-columns), minmax(0, 1fr));
    }

    .akn-trust__service {
      grid-template-columns: auto minmax(0, 1fr);
      gap: var(--gap-xl);
      min-block-size: 0;
      padding-block: var(--akn-trust-padding-desktop);
      padding-inline: clamp(24px, 3vw, 52px);
    }

    .akn-trust__service:first-child {
      padding-inline-start: 0;
    }

    .akn-trust__service:last-child {
      padding-inline-end: 0;
    }

    .akn-trust__service:not(:first-child) {
      border-block-start: 0;
      border-inline-start: 1px solid var(--akn-trust-separator-color);
    }

    .akn-trust__icon {
      inline-size: var(--akn-trust-icon-size-desktop);
      block-size: var(--akn-trust-icon-size-desktop);
    }

    .akn-trust__chevron,
    .akn-trust--mobile-chevrons .akn-trust__service--link .akn-trust__chevron {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:akn_trust.name",
  "class": "akn-trust-section",
  "max_blocks": 4,
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:akn_trust.groups.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:akn_trust.labels.background_color",
      "default": "#1B1714"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "t:akn_trust.labels.icon_color",
      "default": "#C9A56A"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "t:akn_trust.labels.title_color",
      "default": "#F6EEE2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:akn_trust.labels.text_color",
      "default": "#D6C7B7"
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "t:akn_trust.labels.separator_color",
      "default": "#7A634D"
    },
    {
      "type": "header",
      "content": "t:akn_trust.groups.desktop"
    },
    {
      "type": "range",
      "id": "icon_size_desktop",
      "label": "t:akn_trust.labels.icon_size_desktop",
      "min": 20,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "padding_desktop",
      "label": "t:akn_trust.labels.padding_desktop",
      "min": 12,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "t:akn_trust.groups.mobile"
    },
    {
      "type": "range",
      "id": "icon_size_mobile",
      "label": "t:akn_trust.labels.icon_size_mobile",
      "min": 20,
      "max": 56,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "label": "t:akn_trust.labels.padding_mobile",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "checkbox",
      "id": "show_mobile_chevrons",
      "label": "t:akn_trust.labels.show_mobile_chevrons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "t:akn_trust.block_name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:akn_trust.labels.title",
          "default": "t:akn_trust.defaults.service_title"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:akn_trust.labels.text",
          "default": "t:akn_trust.defaults.service_text"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "t:akn_trust.labels.icon",
          "options": [
            {
              "value": "security",
              "label": "t:akn_trust.options.security"
            },
            {
              "value": "delivery",
              "label": "t:akn_trust.options.delivery"
            },
            {
              "value": "contact",
              "label": "t:akn_trust.options.contact"
            },
            {
              "value": "none",
              "label": "t:akn_trust.options.none"
            }
          ],
          "default": "security"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:akn_trust.labels.image",
          "info": "t:akn_trust.help.image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:akn_trust.labels.link",
          "info": "t:akn_trust.help.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:akn_trust.name",
      "category": "t:akn_trust.category",
      "blocks": [
        {
          "type": "service",
          "settings": {
            "title": "t:akn_trust.defaults.payment_title",
            "text": "t:akn_trust.defaults.payment_text",
            "icon": "security"
          }
        },
        {
          "type": "service",
          "settings": {
            "title": "t:akn_trust.defaults.delivery_title",
            "text": "t:akn_trust.defaults.delivery_text",
            "icon": "delivery"
          }
        },
        {
          "type": "service",
          "settings": {
            "title": "t:akn_trust.defaults.contact_title",
            "text": "t:akn_trust.defaults.contact_text",
            "icon": "contact"
          }
        }
      ]
    }
  ]
}
{% endschema %}
