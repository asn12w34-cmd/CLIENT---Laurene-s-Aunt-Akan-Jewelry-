      "options": [
        { "value": "300", "label": "t:akn_policy_page.options.weight_light" },
        { "value": "400", "label": "t:akn_policy_page.options.weight_regular" },
        { "value": "500", "label": "t:akn_policy_page.options.weight_emphasis" }
      ], "default": "400"
    },
    { "type": "header", "content": "t:akn_policy_page.groups.spacing" },
    { "type": "range", "id": "content_width", "label": "t:akn_policy_page.labels.content_width", "min": 1000, "max": 1680, "step": 20, "unit": "px", "default": 1600 },
    { "type": "range", "id": "intro_pad_desktop", "label": "t:akn_policy_page.labels.intro_pad_desktop", "min": 40, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "intro_pad_mobile", "label": "t:akn_policy_page.labels.intro_pad_mobile", "min": 32, "max": 96, "step": 4, "unit": "px", "default": 44 },
    { "type": "range", "id": "content_pad_desktop", "label": "t:akn_policy_page.labels.content_pad_desktop", "min": 40, "max": 120, "step": 4, "unit": "px", "default": 48 },
