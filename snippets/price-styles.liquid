{%- doc -%}
  Shared price styles used by product price, unit price, cart item pricing, quick order list pricing,
  and quick add's dynamically injected product content.

  Render this snippet from any file that directly emits price classes such as
  `.price`, `.compare-at-price`, `.unit-price`, `.tax-note`, `.volume-pricing-note`,
  or `.price-item__group`, unless that file renders the `price` or `unit-price` snippet.

  @example
  {% render 'price-styles' %}
{%- enddoc -%}

{% stylesheet %}
  .price,
  .compare-at-price,
  .unit-price {
    white-space: nowrap;
  }

  .unit-price {
    display: block;
    font-size: min(0.85em, var(--font-paragraph--size));
    color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-subdued-text));
  }

  .tax-note.tax-note.tax-note {
    font-size: min(0.85em, var(--font-paragraph--size));
    font-weight: var(--font-paragraph--weight);
    color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-subdued-text));
  }

  .tax-note:empty {
    display: none;
  }

  product-price.text-block:is(.h1, .h2, .h3, .h4, .h5, .h6) > *:not(.tax-note) {
    margin-block: 0;
  }

  /* Volume pricing note should match unit-price styling (small, grey text) */
  product-price .volume-pricing-note,
  product-price.text-block:is(.h1, .h2, .h3, .h4, .h5, .h6) .volume-pricing-note {
    display: block;
    font-family: var(--font-body--family);
    font-weight: normal;
    font-size: var(--font-size--xs);
    line-height: normal;
    letter-spacing: normal;
    text-transform: none;
    color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-subdued-text));
  }

  .compare-at-price {
    color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-subdued-text));
    text-decoration-line: line-through;
    text-decoration-thickness: 1.5px;
    text-decoration-color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-30));
  }

  .price-item__group {
    display: inline-block;
  }
  /* CUSTOM START [AJ-043] — Shared responsive, non-transactional FCFA secondary prices. | See CUSTOM_CHANGES.md — AJ-043 */
  .akn-fcfa-estimate {
    display: block;
    max-inline-size: 100%;
    min-inline-size: 0;
    font-family: var(--font-body--family);
    font-style: normal;
    font-weight: var(--font-paragraph--weight);
    font-size: min(0.76em, var(--font-paragraph--size));
    line-height: 1.35;
    letter-spacing: normal;
    text-transform: none;
    white-space: normal;
    overflow-wrap: anywhere;
    color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-subdued-text));
  }

  .akn-fcfa-estimate .visually-hidden {
    position: absolute;
  }

  .akn-fcfa-estimate bdi {
    unicode-bidi: isolate;
  }

  /* Existing strike-through semantics also cover the comparable XOF estimate. */
  .compare-at-price .akn-fcfa-estimate {
    text-decoration-line: line-through;
    text-decoration-color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-30));
    text-decoration-thickness: 1.5px;
  }
  .akn-fcfa-cart-note {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: var(--font-size--xs);
    font-weight: var(--font-paragraph--weight);
    line-height: 1.45;
    color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-subdued-text));
  }
  /* CUSTOM END [AJ-043] */
{% endstylesheet %}
