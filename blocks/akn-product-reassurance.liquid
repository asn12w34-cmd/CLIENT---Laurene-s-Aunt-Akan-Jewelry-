{% comment %}
CUSTOM FILE [AJ-019] — Compact AKAN product reassurance row
{% endcomment %}

{% doc %}
  Renders two merchant-editable reassurance messages as one centred purchase
  support row with a visual divider. The layout remains horizontal on mobile.
{% enddoc %}

{% if block.settings.payment_text != blank or block.settings.delivery_text != blank %}
  <div
    class="akn-product-reassurance spacing-style"
    style="
      --akn-reassurance-text: {{ block.settings.text_color }};
      --akn-reassurance-divider: {{ block.settings.divider_color }};
      {% render 'spacing-style', settings: block.settings %}
    "
    {{ block.shopify_attributes }}
  >
    <div class="akn-product-reassurance__item akn-product-reassurance__item--payment">
      <span class="akn-product-reassurance__icon" aria-hidden="true">
        <svg viewBox="0 0 20 20" focusable="false">
          {% render 'icon', icon: 'lock' %}
        </svg>
      </span>
      <span>{{ block.settings.payment_text | escape }}</span>
    </div>

    <span class="akn-product-reassurance__divider" aria-hidden="true"></span>

    <div class="akn-product-reassurance__item akn-product-reassurance__item--delivery">
      <span class="akn-product-reassurance__icon" aria-hidden="true">
        <svg viewBox="0 0 20 20" focusable="false">
          {% render 'icon', icon: 'truck' %}
        </svg>
      </span>
      <span>{{ block.settings.delivery_text | escape }}</span>
    </div>
  </div>
{% endif %}

{% stylesheet %}
  /* CUSTOM [AJ-019] — Centred reassurance pair with mobile-safe wrapping. */
  .product-details .akn-product-reassurance {
    box-sizing: border-box;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1px minmax(0, 1fr);
    gap: 14px;
    align-items: center;
    inline-size: 100%;
    min-inline-size: 0;
    color: var(--akn-reassurance-text, var(--color-foreground));
  }

  .product-details .akn-product-reassurance__item {
    display: flex;
    gap: 7px;
    align-items: center;
    min-inline-size: 0;
    font-family: var(--font-subheading--family);
    font-size: 12px;
    font-style: var(--font-subheading--style);
    font-weight: var(--font-subheading--weight);
    line-height: 1.3;
  }

  .product-details .akn-product-reassurance__item--payment {
    justify-content: flex-end;
    text-align: end;
  }

  .product-details .akn-product-reassurance__item--delivery {
    justify-content: flex-start;
    text-align: start;
  }

  .product-details .akn-product-reassurance__icon {
    display: flex;
    flex: 0 0 17px;
    inline-size: 17px;
    block-size: 17px;
  }

  .product-details .akn-product-reassurance__icon svg {
    inline-size: 100%;
    block-size: 100%;
  }

  .product-details .akn-product-reassurance__divider {
    display: block;
    inline-size: 1px;
    block-size: 18px;
    background: var(--akn-reassurance-divider, currentcolor);
  }

  @media screen and (max-width: 374px) {
    .product-details .akn-product-reassurance {
      gap: 9px;
    }

    .product-details .akn-product-reassurance__item {
      gap: 5px;
      font-size: 11px;
    }

    .product-details .akn-product-reassurance__icon {
      flex-basis: 16px;
      inline-size: 16px;
      block-size: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.akn_product_reassurance",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:names.content"
    },
    {
      "type": "text",
      "id": "payment_text",
      "label": "t:akn_product.labels.payment_text",
      "default": "Paiement sécurisé"
    },
    {
      "type": "text",
      "id": "delivery_text",
      "label": "t:akn_product.labels.delivery_text",
      "default": "Livraison suivie"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "default": "#500714"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "default": "#936222"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.akn_product_reassurance",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
