{% comment %}
CUSTOM FILE [AJ-003] — Reusable responsive rich-text block with independent mobile styling | See CUSTOM_CHANGES.md — AJ-003
CUSTOM UPDATE [AJ-032] — Correct letter spacing cascade and add per-device paragraph typography.
{% endcomment %}

{% doc %}
  Renders responsive rich text while preserving the semantic elements selected in
  Shopify's rich-text editor. Optional mobile content never falls back to desktop
  content after the separate-mobile-content switch is enabled.
{% enddoc %}

{% liquid
  assign desktop_plain = block.settings.desktop_text | strip_newlines | strip
  assign desktop_visible = desktop_plain | strip_html | strip
  assign mobile_plain = block.settings.mobile_text | strip_newlines | strip
  assign mobile_visible = mobile_plain | strip_html | strip
  assign use_mobile_text = block.settings.use_mobile_text

  assign should_render = false
  if desktop_visible != blank
    assign should_render = true
  elsif use_mobile_text and mobile_visible != blank
    assign should_render = true
  endif

  assign desktop_scale = block.settings.desktop_size_scale | divided_by: 100.0
  assign mobile_scale = block.settings.mobile_size_scale | divided_by: 100.0
  assign desktop_heading_line_height = block.settings.desktop_heading_line_height | divided_by: 100.0
  assign desktop_body_line_height = block.settings.desktop_body_line_height | divided_by: 100.0
  assign mobile_heading_line_height = block.settings.mobile_heading_line_height | divided_by: 100.0
  assign mobile_body_line_height = block.settings.mobile_body_line_height | divided_by: 100.0
%}

{% if should_render %}
  <div
    class="akn-text{% if use_mobile_text %} akn-text--separate-mobile{% endif %}{% if desktop_visible == blank %} akn-text--desktop-empty{% endif %}{% if use_mobile_text and mobile_visible == blank %} akn-text--mobile-empty{% endif %}{% if block.settings.desktop_custom_spacing %} akn-text--desktop-custom-spacing{% endif %}{% if block.settings.mobile_custom_spacing %} akn-text--mobile-custom-spacing{% endif %}{% if block.settings.show_divider %} akn-text--divider{% endif %}"
    data-desktop-font="{{ block.settings.desktop_font_role }}"
    data-mobile-font="{{ block.settings.mobile_font_role }}"
    data-desktop-body-font="{{ block.settings.desktop_body_font_role | default: 'native' }}"
    data-mobile-body-font="{{ block.settings.mobile_body_font_role | default: 'native' }}"
    data-desktop-custom-body-size="{{ block.settings.desktop_custom_body_size }}"
    data-mobile-custom-body-size="{{ block.settings.mobile_custom_body_size }}"
    data-desktop-letter-spacing="{{ block.settings.desktop_letter_spacing }}"
    data-mobile-letter-spacing="{{ block.settings.mobile_letter_spacing }}"
    data-desktop-case="{{ block.settings.desktop_case }}"
    data-mobile-case="{{ block.settings.mobile_case }}"
    style="
      --akn-text-desktop-max-width: {{ block.settings.desktop_max_width }}px;
      --akn-text-mobile-max-width: {{ block.settings.mobile_max_width }}px;
      --akn-text-desktop-size-scale: {{ desktop_scale }};
      --akn-text-mobile-size-scale: {{ mobile_scale }};
      --akn-text-desktop-align: {{ block.settings.desktop_alignment }};
      --akn-text-mobile-align: {{ block.settings.mobile_alignment }};
      --akn-text-desktop-color: {{ block.settings.desktop_color }};
      --akn-text-mobile-color: {{ block.settings.mobile_color }};
      --akn-text-desktop-font-family: var(--font-{{ block.settings.desktop_font_role }}--family);
      --akn-text-desktop-font-style: var(--font-{{ block.settings.desktop_font_role }}--style);
      --akn-text-desktop-font-weight: var(--font-{{ block.settings.desktop_font_role }}--weight);
      --akn-text-mobile-font-family: var(--font-{{ block.settings.mobile_font_role }}--family);
      --akn-text-mobile-font-style: var(--font-{{ block.settings.mobile_font_role }}--style);
      --akn-text-mobile-font-weight: var(--font-{{ block.settings.mobile_font_role }}--weight);
      --akn-text-desktop-body-font-family: var(--font-{{ block.settings.desktop_body_font_role | default: 'body' }}--family);
      --akn-text-desktop-body-font-style: var(--font-{{ block.settings.desktop_body_font_role | default: 'body' }}--style);
      --akn-text-desktop-body-font-weight: var(--font-{{ block.settings.desktop_body_font_role | default: 'body' }}--weight);
      --akn-text-mobile-body-font-family: var(--font-{{ block.settings.mobile_body_font_role | default: 'body' }}--family);
      --akn-text-mobile-body-font-style: var(--font-{{ block.settings.mobile_body_font_role | default: 'body' }}--style);
      --akn-text-mobile-body-font-weight: var(--font-{{ block.settings.mobile_body_font_role | default: 'body' }}--weight);
      --akn-text-desktop-body-size: {{ block.settings.desktop_body_size_px | default: 18 }}px;
      --akn-text-mobile-body-size: {{ block.settings.mobile_body_size_px | default: 16 }}px;
      --akn-text-desktop-heading-line-height: {{ desktop_heading_line_height }};
      --akn-text-desktop-body-line-height: {{ desktop_body_line_height }};
      --akn-text-mobile-heading-line-height: {{ mobile_heading_line_height }};
      --akn-text-mobile-body-line-height: {{ mobile_body_line_height }};
      --akn-text-desktop-element-gap: {{ block.settings.desktop_element_gap }}px;
      --akn-text-mobile-element-gap: {{ block.settings.mobile_element_gap }}px;
      --akn-text-desktop-heading-letter-spacing: var(--letter-spacing--heading-{{ block.settings.desktop_letter_spacing }});
      --akn-text-desktop-body-letter-spacing: var(--letter-spacing--body-{{ block.settings.desktop_letter_spacing }});
      --akn-text-mobile-heading-letter-spacing: var(--letter-spacing--heading-{{ block.settings.mobile_letter_spacing }});
      --akn-text-mobile-body-letter-spacing: var(--letter-spacing--body-{{ block.settings.mobile_letter_spacing }});
      --akn-text-desktop-custom-letter-spacing: {{ block.settings.desktop_letter_spacing_custom }}px;
      --akn-text-desktop-custom-word-spacing: {{ block.settings.desktop_word_spacing_custom }}px;
      --akn-text-mobile-custom-letter-spacing: {{ block.settings.mobile_letter_spacing_custom }}px;
      --akn-text-mobile-custom-word-spacing: {{ block.settings.mobile_word_spacing_custom }}px;
      --akn-text-desktop-padding-block: {{ block.settings.desktop_padding_vertical }}px;
      --akn-text-desktop-padding-inline: {{ block.settings.desktop_padding_horizontal }}px;
      --akn-text-mobile-padding-block: {{ block.settings.mobile_padding_vertical }}px;
      --akn-text-mobile-padding-inline: {{ block.settings.mobile_padding_horizontal }}px;
      --akn-text-background: {{ block.settings.background_color }};
      --akn-text-border-color: {{ block.settings.border_color }};
      --akn-text-border-width: {{ block.settings.border_width }}px;
      --akn-text-radius: {{ block.settings.corner_radius }}px;
      --akn-text-divider-color: {{ block.settings.divider_color }};
      --akn-text-divider-width: {{ block.settings.divider_width }}px;
      --akn-text-divider-thickness: {{ block.settings.divider_thickness }}px;
      --akn-text-divider-gap: {{ block.settings.divider_gap }}px;
    "
    {{ block.shopify_attributes }}
  >
    {% if desktop_visible != blank %}
      <rte-formatter class="akn-text__content akn-text__content--desktop rte">
        {{ block.settings.desktop_text }}
      </rte-formatter>
    {% endif %}

    {% if use_mobile_text and mobile_visible != blank %}
      <rte-formatter class="akn-text__content akn-text__content--mobile rte">
        {{ block.settings.mobile_text }}
      </rte-formatter>
    {% endif %}
  </div>
{% endif %}

{% stylesheet %}
  /* CUSTOM [AJ-003] — Responsive rich-text presentation | See CUSTOM_CHANGES.md — AJ-003 */
  .akn-text {
    box-sizing: border-box;
    inline-size: min(100%, var(--akn-text-desktop-max-width));
    max-inline-size: 100%;
    min-inline-size: 0;
    block-size: auto;
    padding-block: var(--akn-text-desktop-padding-block);
    padding-inline: var(--akn-text-desktop-padding-inline);
    color: var(--akn-text-desktop-color, currentcolor);
    background: var(--akn-text-background, transparent);
    border: var(--akn-text-border-width) solid var(--akn-text-border-color, transparent);
    border-radius: var(--akn-text-radius);
  }

  .akn-text__content {
    --color: currentcolor;

    display: block;
    inline-size: 100%;
    min-inline-size: 0;
    block-size: auto;
    color: inherit;
    overflow-wrap: anywhere;
  }

  .akn-text__content--desktop {
    text-align: var(--akn-text-desktop-align);
  }

  .akn-text .akn-text__content--desktop > :where(*) {
    margin-block: 0;
  }

  .akn-text .akn-text__content--desktop > :where(*) + :where(*) {
    margin-block-start: var(--akn-text-desktop-element-gap);
  }

  .akn-text__content--mobile {
    display: none;
  }

  .akn-text__content :where(h1) {
    font-size: calc(var(--font-h1--size) * var(--akn-text-desktop-size-scale));
    line-height: var(--akn-text-desktop-heading-line-height);
  }

  .akn-text__content :where(h2) {
    font-size: calc(var(--font-h2--size) * var(--akn-text-desktop-size-scale));
    line-height: var(--akn-text-desktop-heading-line-height);
  }

  .akn-text__content :where(h3) {
    font-size: calc(var(--font-h3--size) * var(--akn-text-desktop-size-scale));
    line-height: var(--akn-text-desktop-heading-line-height);
  }

  .akn-text__content :where(h4) {
    font-size: calc(var(--font-h4--size) * var(--akn-text-desktop-size-scale));
    line-height: var(--akn-text-desktop-heading-line-height);
  }

  .akn-text__content :where(h5) {
    font-size: calc(var(--font-h5--size) * var(--akn-text-desktop-size-scale));
    line-height: var(--akn-text-desktop-heading-line-height);
  }

  .akn-text__content :where(h6) {
    font-size: calc(var(--font-h6--size) * var(--akn-text-desktop-size-scale));
    line-height: var(--akn-text-desktop-heading-line-height);
  }

  .akn-text__content :where(p, ul, ol, blockquote) {
    font-size: calc(var(--font-paragraph--size) * var(--akn-text-desktop-size-scale));
    line-height: var(--akn-text-desktop-body-line-height);
  }

  .akn-text:not([data-desktop-font='native']) .akn-text__content--desktop,
  .akn-text:not([data-desktop-font='native']) .akn-text__content--desktop :where(*) {
    font-family: var(--akn-text-desktop-font-family);
    font-style: var(--akn-text-desktop-font-style);
    font-weight: var(--akn-text-desktop-font-weight);
  }

  /* CUSTOM [AJ-032] — Opt-in paragraph styling does not affect headings or other blocks. */
  .akn-text:not([data-desktop-body-font='native']) .akn-text__content--desktop :where(p, ul, ol, blockquote) {
    font-family: var(--akn-text-desktop-body-font-family);
    font-style: var(--akn-text-desktop-body-font-style);
    font-weight: var(--akn-text-desktop-body-font-weight);
  }

  .akn-text[data-desktop-custom-body-size='true'] .akn-text__content--desktop :where(p, ul, ol, blockquote) {
    font-size: var(--akn-text-desktop-body-size);
  }

  /* CUSTOM [AJ-032] — Preset tracking yields to precise letter/word spacing. */
  .akn-text:not(.akn-text--desktop-custom-spacing):not([data-desktop-letter-spacing='native']) .akn-text__content--desktop :where(h1, h2, h3, h4, h5, h6) {
    letter-spacing: var(--akn-text-desktop-heading-letter-spacing);
  }

  .akn-text:not(.akn-text--desktop-custom-spacing):not([data-desktop-letter-spacing='native']) .akn-text__content--desktop :where(p, ul, ol, blockquote) {
    letter-spacing: var(--akn-text-desktop-body-letter-spacing);
  }

  .akn-text--desktop-custom-spacing .akn-text__content--desktop :where(h1, h2, h3, h4, h5, h6, p, ul, ol, blockquote) {
    letter-spacing: var(--akn-text-desktop-custom-letter-spacing);
    word-spacing: var(--akn-text-desktop-custom-word-spacing);
  }

  .akn-text--divider .akn-text__content > :where(*) + :where(*)::before {
    content: '';
    display: block;
    inline-size: min(100%, var(--akn-text-divider-width));
    margin-block-end: var(--akn-text-divider-gap);
    border-block-start: var(--akn-text-divider-thickness) solid var(--akn-text-divider-color);
  }

  .akn-text:not([data-desktop-case='native']) .akn-text__content--desktop,
  .akn-text:not([data-desktop-case='native']) .akn-text__content--desktop :where(*) {
    text-transform: var(--akn-text-desktop-case);
  }

  .akn-text[data-desktop-case='none'] {
    --akn-text-desktop-case: none;
  }

  .akn-text[data-desktop-case='uppercase'] {
    --akn-text-desktop-case: uppercase;
  }

  .akn-text[data-desktop-case='lowercase'] {
    --akn-text-desktop-case: lowercase;
  }

  @media screen and (max-width: 749px) {
    .akn-text {
      inline-size: min(100%, var(--akn-text-mobile-max-width));
      padding-block: var(--akn-text-mobile-padding-block);
      padding-inline: var(--akn-text-mobile-padding-inline);
      color: var(--akn-text-mobile-color, currentcolor);
    }

    .akn-text--mobile-empty {
      display: none;
    }

    .akn-text--separate-mobile .akn-text__content--desktop {
      display: none;
    }

    .akn-text--separate-mobile .akn-text__content--mobile {
      display: block;
    }

    .akn-text__content {
      text-align: var(--akn-text-mobile-align);
    }

    .akn-text .akn-text__content > :where(*) {
      margin-block: 0;
    }

    .akn-text .akn-text__content > :where(*) + :where(*) {
      margin-block-start: var(--akn-text-mobile-element-gap);
    }

    .akn-text__content :where(h1) {
      font-size: calc(var(--font-h1--size) * var(--akn-text-mobile-size-scale));
      line-height: var(--akn-text-mobile-heading-line-height);
    }

    .akn-text__content :where(h2) {
      font-size: calc(var(--font-h2--size) * var(--akn-text-mobile-size-scale));
      line-height: var(--akn-text-mobile-heading-line-height);
    }

    .akn-text__content :where(h3) {
      font-size: calc(var(--font-h3--size) * var(--akn-text-mobile-size-scale));
      line-height: var(--akn-text-mobile-heading-line-height);
    }

    .akn-text__content :where(h4) {
      font-size: calc(var(--font-h4--size) * var(--akn-text-mobile-size-scale));
      line-height: var(--akn-text-mobile-heading-line-height);
    }

    .akn-text__content :where(h5) {
      font-size: calc(var(--font-h5--size) * var(--akn-text-mobile-size-scale));
      line-height: var(--akn-text-mobile-heading-line-height);
    }

    .akn-text__content :where(h6) {
      font-size: calc(var(--font-h6--size) * var(--akn-text-mobile-size-scale));
      line-height: var(--akn-text-mobile-heading-line-height);
    }

    .akn-text__content :where(p, ul, ol, blockquote) {
      font-size: calc(var(--font-paragraph--size) * var(--akn-text-mobile-size-scale));
      line-height: var(--akn-text-mobile-body-line-height);
    }

    .akn-text:not([data-mobile-font='native']) .akn-text__content,
    .akn-text:not([data-mobile-font='native']) .akn-text__content :where(*) {
      font-family: var(--akn-text-mobile-font-family);
      font-style: var(--akn-text-mobile-font-style);
      font-weight: var(--akn-text-mobile-font-weight);
    }

    /* CUSTOM [AJ-032] — Phone-only paragraph overrides, independent of desktop. */
    .akn-text:not([data-mobile-body-font='native']) .akn-text__content--mobile :where(p, ul, ol, blockquote),
    .akn-text:not([data-mobile-body-font='native']) .akn-text__content--desktop :where(p, ul, ol, blockquote) {
      font-family: var(--akn-text-mobile-body-font-family);
      font-style: var(--akn-text-mobile-body-font-style);
      font-weight: var(--akn-text-mobile-body-font-weight);
    }

    .akn-text[data-mobile-custom-body-size='true'] .akn-text__content :where(p, ul, ol, blockquote) {
      font-size: var(--akn-text-mobile-body-size);
    }

    .akn-text:not(.akn-text--mobile-custom-spacing):not([data-mobile-letter-spacing='native']) .akn-text__content :where(h1, h2, h3, h4, h5, h6) {
      letter-spacing: var(--akn-text-mobile-heading-letter-spacing);
    }

    .akn-text:not(.akn-text--mobile-custom-spacing):not([data-mobile-letter-spacing='native']) .akn-text__content :where(p, ul, ol, blockquote) {
      letter-spacing: var(--akn-text-mobile-body-letter-spacing);
    }

    .akn-text--mobile-custom-spacing .akn-text__content :where(h1, h2, h3, h4, h5, h6, p, ul, ol, blockquote) {
      letter-spacing: var(--akn-text-mobile-custom-letter-spacing);
      word-spacing: var(--akn-text-mobile-custom-word-spacing);
    }

    .akn-text:not([data-mobile-case='native']) .akn-text__content,
    .akn-text:not([data-mobile-case='native']) .akn-text__content :where(*) {
      text-transform: var(--akn-text-mobile-case);
    }

    .akn-text[data-mobile-case='none'] {
      --akn-text-mobile-case: none;
    }

    .akn-text[data-mobile-case='uppercase'] {
      --akn-text-mobile-case: uppercase;
    }

    .akn-text[data-mobile-case='lowercase'] {
      --akn-text-mobile-case: lowercase;
    }
  }

  @media screen and (min-width: 750px) {
    .akn-text--desktop-empty {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "AKAN — Texte responsive",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "desktop_text",
      "label": "Contenu — ordinateur"
    },
    {
      "type": "checkbox",
      "id": "use_mobile_text",
      "label": "Utiliser un contenu différent sur mobile",
      "default": false
    },
    {
      "type": "richtext",
      "id": "mobile_text",
      "label": "Contenu — mobile",
      "visible_if": "{{ block.settings.use_mobile_text }}"
    },
    {
      "type": "header",
      "content": "Typographie — ordinateur"
    },
    {
      "type": "select",
      "id": "desktop_font_role",
      "label": "Style de police",
      "options": [
        { "value": "native", "label": "Conserver les styles du contenu" },
        { "value": "body", "label": "t:settings.akn_editorial_update.body" },
        { "value": "subheading", "label": "t:settings.akn_editorial_update.subheading" },
        { "value": "heading", "label": "t:settings.akn_editorial_update.heading" },
        { "value": "accent", "label": "t:settings.akn_editorial_update.accent" }
      ],
      "default": "native"
    },
    {
      "type": "range",
      "id": "desktop_size_scale",
      "label": "Échelle de taille",
      "min": 75,
      "max": 130,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "desktop_heading_line_height",
      "label": "Interligne des titres",
      "info": "Règle l'espace entre les lignes d'un titre sur ordinateur.",
      "min": 85,
      "max": 160,
      "step": 1,
      "unit": "%",
      "default": 110
    },
    {
      "type": "range",
      "id": "desktop_body_line_height",
      "label": "Interligne du texte",
      "info": "Règle l'espace entre les lignes des paragraphes et des listes sur ordinateur.",
      "min": 95,
      "max": 180,
      "step": 1,
      "unit": "%",
      "default": 140
    },
    {
      "type": "select",
      "id": "desktop_body_font_role",
      "label": "t:settings.akn_editorial_update.body_font",
      "info": "t:settings.akn_editorial_update.body_font_info",
      "options": [
        { "value": "native", "label": "t:settings.akn_editorial_update.theme_default" },
        { "value": "body", "label": "t:settings.akn_editorial_update.body" },
        { "value": "subheading", "label": "t:settings.akn_editorial_update.subheading" },
        { "value": "heading", "label": "t:settings.akn_editorial_update.heading" },
        { "value": "accent", "label": "t:settings.akn_editorial_update.accent" }
      ],
      "default": "native"
    },
    {
      "type": "checkbox",
      "id": "desktop_custom_body_size",
      "label": "t:settings.akn_editorial_update.custom_body_size",
      "default": false
    },
    {
      "type": "range",
      "id": "desktop_body_size_px",
      "label": "t:settings.akn_editorial_update.body_size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 18,
      "visible_if": "{{ block.settings.desktop_custom_body_size }}"
    },
    {
      "type": "range",
      "id": "desktop_element_gap",
      "label": "Espacement entre les éléments",
      "info": "Espace entre le surtitre, le titre, le texte et les autres éléments du contenu.",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "desktop_letter_spacing",
      "label": "Espacement des lettres",
      "options": [
        { "value": "native", "label": "Valeur du thème" },
        { "value": "tight", "label": "Resserré" },
        { "value": "normal", "label": "Normal" },
        { "value": "loose", "label": "Espacé" }
      ],
      "default": "native",
      "visible_if": "{{ block.settings.desktop_custom_spacing == false }}"
    },
    {
      "type": "checkbox",
      "id": "desktop_custom_spacing",
      "label": "t:settings.custom_typographic_spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "desktop_letter_spacing_custom",
      "label": "t:settings.letter_spacing",
      "min": -1,
      "max": 8,
      "step": 0.1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.desktop_custom_spacing }}"
    },
    {
      "type": "range",
      "id": "desktop_word_spacing_custom",
      "label": "t:settings.word_spacing",
      "min": -2,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.desktop_custom_spacing }}"
    },
    {
      "type": "text_alignment",
      "id": "desktop_alignment",
      "label": "Alignement du texte",
      "default": "left"
    },
    {
      "type": "select",
      "id": "desktop_case",
      "label": "Casse du texte",
      "options": [
        { "value": "native", "label": "Valeur du thème" },
        { "value": "none", "label": "Comme saisi" },
